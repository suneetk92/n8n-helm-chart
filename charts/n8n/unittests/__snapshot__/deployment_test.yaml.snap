should match snapshot of default values:
  1: |
    apiVersion: v1
    data:
      N8N_BLOCK_ENV_ACCESS_IN_NODE: "true"
      N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS: "true"
      N8N_GIT_NODE_DISABLE_BARE_REPOS: "true"
    kind: ConfigMap
    metadata:
      labels:
        app: n8n
        chart: n8n-1.0.0
        heritage: Helm
        release: n8n
      name: n8n-security-configmap
  2: |
    apiVersion: v1
    data:
      DB_SQLITE_DATABASE: database.sqlite
      DB_SQLITE_POOL_SIZE: "3"
      DB_SQLITE_VACUUM_ON_STARTUP: "false"
      DB_TYPE: sqlite
    kind: ConfigMap
    metadata:
      labels:
        app: n8n
        chart: n8n-1.0.0
        heritage: Helm
        release: n8n
      name: n8n-database-configmap
  3: |
    apiVersion: v1
    data:
      N8N_LOG_FORMAT: text
      N8N_LOG_LEVEL: info
      N8N_LOG_OUTPUT: console
    kind: ConfigMap
    metadata:
      labels:
        app: n8n
        chart: n8n-1.0.0
        heritage: Helm
        release: n8n
      name: n8n-logging-configmap
  4: |
    apiVersion: v1
    data:
      N8N_DIAGNOSTICS_CONFIG_BACKEND: ""
      N8N_DIAGNOSTICS_CONFIG_FRONTEND: ""
      N8N_DIAGNOSTICS_ENABLED: "false"
      N8N_DIAGNOSTICS_POSTHOG_API_HOST: ""
      N8N_DIAGNOSTICS_POSTHOG_API_KEY: ""
      N8N_FRONTEND_SENTRY_DSN: ""
      N8N_SENTRY_DSN: ""
    kind: ConfigMap
    metadata:
      labels:
        app: n8n
        chart: n8n-1.0.0
        heritage: Helm
        release: n8n
      name: n8n-diagnostics-configmap
  5: |
    apiVersion: v1
    data:
      N8N_VERSION_NOTIFICATIONS_ENABLED: "false"
    kind: ConfigMap
    metadata:
      labels:
        app: n8n
        chart: n8n-1.0.0
        heritage: Helm
        release: n8n
      name: n8n-version-notifications-configmap
  6: |
    apiVersion: v1
    data:
      N8N_PUBLIC_API_DISABLED: "false"
      N8N_PUBLIC_API_ENDPOINT: api
      N8N_PUBLIC_API_SWAGGERUI_DISABLED: "false"
    kind: ConfigMap
    metadata:
      labels:
        app: n8n
        chart: n8n-1.0.0
        heritage: Helm
        release: n8n
      name: n8n-public-api-configmap
  7: |
    apiVersion: v1
    data:
      N8N_WORKFLOW_HISTORY_ENABLED: "true"
      N8N_WORKFLOW_HISTORY_PRUNE_TIME: "336"
    kind: ConfigMap
    metadata:
      labels:
        app: n8n
        chart: n8n-1.0.0
        heritage: Helm
        release: n8n
      name: n8n-workflow-history-configmap
  8: |
    apiVersion: v1
    data:
      N8N_RUNNERS_HEARTBEAT_INTERVAL: "30"
      N8N_RUNNERS_MAX_CONCURRENCY: "5"
      N8N_RUNNERS_MODE: internal
      N8N_RUNNERS_TASK_TIMEOUT: "60"
    kind: ConfigMap
    metadata:
      labels:
        app: n8n
        chart: n8n-1.0.0
        heritage: Helm
        release: n8n
      name: n8n-task-broker-configmap
  9: |
    apiVersion: v1
    data:
      N8N_METRICS: "false"
      N8N_METRICS_INCLUDE_API_ENDPOINTS: "false"
      N8N_METRICS_INCLUDE_API_METHOD_LABEL: "false"
      N8N_METRICS_INCLUDE_API_PATH_LABEL: "false"
      N8N_METRICS_INCLUDE_API_STATUS_CODE_LABEL: "false"
      N8N_METRICS_INCLUDE_CACHE_METRICS: "false"
      N8N_METRICS_INCLUDE_CREDENTIAL_TYPE_LABEL: "false"
      N8N_METRICS_INCLUDE_DEFAULT_METRICS: "true"
      N8N_METRICS_INCLUDE_MESSAGE_EVENT_BUS_METRICS: "false"
      N8N_METRICS_INCLUDE_NODE_TYPE_LABEL: "false"
      N8N_METRICS_INCLUDE_QUEUE_METRICS: "false"
      N8N_METRICS_INCLUDE_WORKFLOW_ID_LABEL: "false"
      N8N_METRICS_PREFIX: n8n_
    kind: ConfigMap
    metadata:
      labels:
        app: n8n
        chart: n8n-1.0.0
        heritage: Helm
        release: n8n
      name: n8n-metrics-configmap
  10: |
    apiVersion: v1
    data: null
    kind: ConfigMap
    metadata:
      labels:
        app: n8n
        chart: n8n-1.0.0
        heritage: Helm
        release: n8n
      name: n8n-binary-data-configmap
  11: |
    apiVersion: v1
    data:
      EXECUTIONS_DATA_HARD_DELETE_BUFFER: "1"
      EXECUTIONS_DATA_MAX_AGE: "336"
      EXECUTIONS_DATA_MAX_DISPLAY_SIZE: "104857600"
      EXECUTIONS_DATA_PRUNE: "false"
      EXECUTIONS_DATA_PRUNE_MAX_COUNT: "10000"
      EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS: "true"
      EXECUTIONS_DATA_SAVE_ON_ERROR: all
      EXECUTIONS_DATA_SAVE_ON_PROGRESS: "false"
      EXECUTIONS_DATA_SAVE_ON_SUCCESS: all
      EXECUTIONS_TIMEOUT: "-1"
      EXECUTIONS_TIMEOUT_MAX: "3600"
      N8N_FORMDATA_FILE_SIZE_MAX: "200"
      N8N_PAYLOAD_SIZE_MAX: "16"
    kind: ConfigMap
    metadata:
      labels:
        app: n8n
        chart: n8n-1.0.0
        heritage: Helm
        release: n8n
      name: n8n-operations-configmap
  12: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: main
        app.kubernetes.io/instance: n8n
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: n8n
        app.kubernetes.io/part-of: n8n
        app.kubernetes.io/version: 1.0.0
        helm.sh/chart: n8n-1.0.0
      name: n8n
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: n8n
          app.kubernetes.io/name: n8n
      strategy:
        rollingUpdate:
          maxSurge: 25%
          maxUnavailable: 25%
        type: RollingUpdate
      template:
        metadata:
          annotations:
            checksum/config: fe0bc1148e12ce984728ae9765680d8d3f3ce254344acdcaf2de902120a487a6
          labels:
            app.kubernetes.io/component: main
            app.kubernetes.io/instance: n8n
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: n8n
            app.kubernetes.io/part-of: n8n
            app.kubernetes.io/version: 1.0.0
            helm.sh/chart: n8n-1.0.0
        spec:
          containers:
            - env:
                - name: N8N_HIRING_BANNER_ENABLED
                  value: "false"
                - name: NODE_ENV
                  value: production
                - name: N8N_PORT
                  value: "5678"
                - name: N8N_DEFAULT_LOCALE
                  value: en
                - name: GENERIC_TIMEZONE
                  value: Europe/Berlin
                - name: N8N_GRACEFUL_SHUTDOWN_TIMEOUT
                  value: "30"
                - name: NPM_CONFIG_CACHE
                  value: /home/node/.cache/npm
              envFrom:
                - configMapRef:
                    name: n8n-security-configmap
                - configMapRef:
                    name: n8n-database-configmap
                - configMapRef:
                    name: n8n-logging-configmap
                - configMapRef:
                    name: n8n-diagnostics-configmap
                - configMapRef:
                    name: n8n-version-notifications-configmap
                - configMapRef:
                    name: n8n-public-api-configmap
                - configMapRef:
                    name: n8n-workflow-history-configmap
                - configMapRef:
                    name: n8n-task-broker-configmap
                - configMapRef:
                    name: n8n-metrics-configmap
                - configMapRef:
                    name: n8n-binary-data-configmap
                - secretRef:
                    name: n8n-encryption-key-secret-v2
                - configMapRef:
                    name: n8n-operations-configmap
              image: n8nio/n8n:1.0.0
              imagePullPolicy: IfNotPresent
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: http
              name: n8n-main
              ports:
                - containerPort: 5678
                  name: http
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /healthz/readiness
                  port: http
              resources: {}
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                privileged: false
                readOnlyRootFilesystem: true
                runAsGroup: 1000
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /home/node/.cache
                  name: cache
                - mountPath: /home/node/.npm
                  name: npm-home
                - mountPath: /home/node/.n8n
                  name: node-modules
                  readOnly: false
          securityContext:
            fsGroup: 1000
            fsGroupChangePolicy: OnRootMismatch
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: n8n
          volumes:
            - emptyDir: {}
              name: tmp
            - emptyDir: {}
              name: cache
            - emptyDir: {}
              name: npm-home
            - emptyDir: {}
              name: node-modules
  13: |
    apiVersion: v1
    data:
      N8N_ENCRYPTION_KEY: dGVzdC1lbmNyeXB0aW9uLWtleQ==
    kind: Secret
    metadata:
      annotations:
        meta.helm.sh/release-name: n8n
        meta.helm.sh/release-namespace: n8n
      labels:
        app: n8n
        app.kubernetes.io/managed-by: Helm
        chart: n8n-1.0.0
        heritage: Helm
        release: n8n
      name: n8n-encryption-key-secret-v2
      namespace: n8n
    type: Opaque
