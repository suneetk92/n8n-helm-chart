                  name: cache
                - mountPath: /home/node/.npm
                  name: npm-home
                - mountPath: /home/node/.n8n
                  name: node-modules
                  readOnly: false
                - mountPath: /home/node/certs/ca/ca.crt
                  name: pg-ssl-ca
                  readOnly: true
                  subPath: ca.crt
                - mountPath: /home/node/certs/cert/cert.crt
