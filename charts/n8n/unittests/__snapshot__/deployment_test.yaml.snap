            - emptyDir: {}
              name: npm-home
            - emptyDir: {}
              name: node-modules
            - name: pg-ssl-ca
              secret:
                items:
                  - key: root.crt
                    path: ca.crt
                secretName: my-ca-cert-secret
            - name: pg-ssl-cert
              secret:
                items:
                  - key: client.crt
                    path: cert.crt
                secretName: my-client-cert-secret
            - name: pg-ssl-key
              secret:
                items:
                  - key: client.key
                    path: cert.key
                secretName: my-client-cert-private-key-secret
